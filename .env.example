# Copy to .env for local use, or export these in your shell.
GROQ_API_KEY=
# Model names can differ per Groq account; change any of the three if yours is refused.
GENERATION_MODEL=openai/gpt-oss-20b
GRADER_MODEL=openai/gpt-oss-20b
GROUNDING_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional Hugging Face token (hides the "unauthenticated requests" notice, higher download limits)
HF_TOKEN=
CHROMA_DIR=chroma_db
FEEDBACK_DB=data/feedback.sqlite3
STRUCTURED_OUTPUT_METHOD=json_schema
TOP_K=5
MAX_RETRIES=2
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Rate limits (Groq free tier is low per minute)
GRADING_CONCURRENCY=2
GRADING_CHUNK_CHARS=1200
EVAL_PAUSE=5

# Optional features
ENABLE_HALLUCINATION_CHECK=true
ENABLE_MEMORY=true

# Only used by ui.py
API_BASE_URL=http://localhost:8000
