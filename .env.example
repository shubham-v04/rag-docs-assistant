# Copy to .env for local use, or export these in your shell.
GROQ_API_KEY=
GENERATION_MODEL=llama-3.3-70b-versatile
GRADER_MODEL=llama-3.1-8b-instant
GROUNDING_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
FEEDBACK_DB=data/feedback.sqlite3
TOP_K=5
MAX_RETRIES=2
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional features
ENABLE_HALLUCINATION_CHECK=true
ENABLE_MEMORY=true

# Only used by ui.py
API_BASE_URL=http://localhost:8000
