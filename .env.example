# Copy to .env for local use, or export these in your shell.
GROQ_API_KEY=
# Model names can differ per Groq account; change any of the three if yours is refused.
GENERATION_MODEL=openai/gpt-oss-20b
GRADER_MODEL=openai/gpt-oss-20b
GROUNDING_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
FEEDBACK_DB=data/feedback.sqlite3
TOP_K=5
MAX_RETRIES=2
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional features
ENABLE_HALLUCINATION_CHECK=true
ENABLE_MEMORY=true

# Only used by ui.py
API_BASE_URL=http://localhost:8000
